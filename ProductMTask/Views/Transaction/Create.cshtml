@model TransationDto

<div class="container mt-5">
    <h2 class="text-primary">Create New Transaction</h2>

    <form id="transactionForm">
        <div class="mb-3">
            <label for="productName" class="form-label">Product</label>
            <select class="form-control" name="Code" id="Code">
                @foreach (var product in ViewBag.products)
                {
                    <option value="@product.Code">@product.Name</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label for="quantity" class="form-label">Quantity</label>
            <input type="number" id="quantity" name="quantity" class="form-control" required />
        </div>
        <div class="mb-3">
            <label for="date" class="form-label">Date</label>
            <input type="date" id="date" name="date" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary">Save Transaction</button>
    </form>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
  
        function calculateTotalPrice() {
            const quantity = $('#quantity').val();
            const productPrice = $('#productId option:selected').data('price'); 

            if (quantity && productPrice) {
                const totalPrice = quantity * productPrice;
                $('#totalPrice').val(totalPrice);
            }
        }

    
        $('#transactionForm').submit(function (e) {
            e.preventDefault();

            const data = {
                code: $('#Code').val(),
                quantity: $('#quantity').val(),
                date: $('#date').val(),
                unit: $('#unit').val(),
                totalPrice: $('#totalPrice').val()
            };

            $.ajax({
                url: '/Transaction/Create',
                method: 'POST',
                data: data,
                success: function (response) {
                    if (response.success) {
                        alert('Transaction created successfully!');
                        window.location.href = '/Transaction/Index'; // العودة إلى قائمة المعاملات
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function () {
                    alert('Error saving transaction.');
                }
            });
        });

        // حساب الإجمالي عند تغيير الكمية
        $('#quantity').on('input', function () {
            calculateTotalPrice();
        });
    </script>
}
