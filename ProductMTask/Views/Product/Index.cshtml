@model IEnumerable<ProductDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">Product List</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Create New
        </a>
    </div>

    <table class="table table-striped table-hover text-center align-middle">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.First().Name)</th>
                <th>@Html.DisplayNameFor(model => model.First().Unit)</th>
                <th>@Html.DisplayNameFor(model => model.First().Price)</th>
                <th>@Html.DisplayNameFor(model => model.First().InitialQuantity)</th>
                <th>@Html.DisplayNameFor(model => model.First().Code)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="productTable">
            <!-- AJAX content will be injected here -->
        </tbody>
    </table>
</div>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function loadProducts() {
            $.ajax({
                url: '/Product/LoadProducts',
                method: 'GET',
                success: function (data) {
                    $('#productTable').html('');
                    data.forEach(function (item) {
                        $('#productTable').append(`
                            <tr>
                                <td>${item.name}</td>
                                <td>${item.unit}</td>
                                <td>${item.price}</td>
                                <td>${item.initialQuantity}</td>
                                <td>${item.code}</td>
                                <td>
                                    <a href="/Product/Edit/${item.code}" class="btn btn-sm btn-primary">Edit</a>
                                    <button class="btn btn-sm btn-danger" onclick="confirmDelete('${item.code}')">Delete</button>
                                </td>
                            </tr>
                        `);
                    });
                },
                error: function () {
                    alert('Error loading products.');
                }
            });
        }

        function confirmDelete(code) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won’t be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Product/Delete',
                        method: 'POST',
                        data: { code: code },
                        success: function () {
                            Swal.fire(
                                'Deleted!',
                                'Product has been deleted.',
                                'success'
                            );
                            loadProducts(); // Reload table
                        },
                        error: function () {
                            Swal.fire(
                                'Error!',
                                'There was a problem deleting the product.',
                                'error'
                            );
                        }
                    });
                }
            });
        }

        $(document).ready(function () {
            loadProducts();
        });
    </script>
}

